# Puerto HTTP del servidor MCP
PORT=3000

# URL pública del Web App COM ya desplegado.
# Ejemplo: https://script.google.com/macros/s/XXXXXXXXXXXX/exec
COM_FAST_PATH_URL=

# Secreto existente del Web App COM.
# NUNCA se expone como argumento de ENCOLAR_COM.
COM_FAST_PATH_SECRET=

# Clave independiente para POST /encolar-com.\n# Úsala como Authorization: Bearer <clave> o x-castabot-api-key.\n# Debe ser diferente de COM_FAST_PATH_SECRET.\nCASTABOT_API_KEY=\n\n# Host público esperado por el servidor MCP cuando se despliegue.
# Para desarrollo local se puede dejar vacío.
# Ejemplo: mcp.castabot.mx
MCP_ALLOWED_HOST=

# Origen web permitido, solo si se necesita tráfico de navegador.
# Los clientes MCP normales sin Origin no lo requieren.
MCP_ALLOWED_ORIGIN=

# Token opcional para /.well-known/openai-apps-challenge
# Solo será necesario cuando OpenAI entregue un token de verificación de dominio.
OPENAI_APPS_CHALLENGE=

# La lectura operativa encapsulada reutiliza COM_FAST_PATH_URL y
# COM_FAST_PATH_SECRET para invocar accion=LEER_DATOS_CASTABOT.
# No requiere Google Cloud ni claves de cuenta de servicio.
